---
import PlanCard from '@components/plan-card.astro';
import { plans } from '@data/plans';
import BaseLayout from '@layouts/base-layout.astro';
---

<BaseLayout title="Pricing" description="Plans for WTF POS. Contact us to get started.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <h1 class="rise font-serif text-5xl font-semibold tracking-tight sm:text-6xl">Simple pricing.</h1>
    <p class="rise mt-5 max-w-2xl text-lg text-latte sm:text-xl" style="--d: 120ms">
      Plans for WTF POS. There is no online checkout yet: contact us and we will set you up.
    </p>
    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {plans.map((plan, index) => <PlanCard plan={plan} delay={index * 120} />)}
    </div>
    <p class="mt-8 text-sm text-latte">Prices shown are placeholders.</p>
  </section>
</BaseLayout>
