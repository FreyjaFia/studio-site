---
import PlanCard from '@components/plan-card.astro';
import { apps } from '@data/apps';
import { plans } from '@data/plans';
import BaseLayout from '@layouts/base-layout.astro';

const pricedApps = apps.filter((app) => plans.some((plan) => plan.appSlug === app.slug));
---

<BaseLayout title="Pricing" description="Plans for our apps. Contact us to get started.">
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:py-24">
    <h1 class="rise font-serif text-5xl font-semibold tracking-tight sm:text-6xl">Simple pricing.</h1>
    <p class="rise mt-5 max-w-2xl text-lg text-latte sm:text-xl" style="--d: 120ms">
      There is no online checkout yet: contact us and we will set you up.
    </p>

    {
      pricedApps.map((app) => (
        <div id={app.slug} class="mt-16 scroll-mt-24" style={`--accent: ${app.accent}`}>
          <h2 data-reveal class="flex items-center gap-3 font-serif text-3xl font-semibold">
            <span class="size-3.5 rounded-full bg-(--accent)"></span>
            {app.name}
          </h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {plans
              .filter((plan) => plan.appSlug === app.slug)
              .map((plan, index) => (
                
                  <PlanCard plan={plan} delay={index * 120} />
                
              ))}
          </div>
        </div>
      ))
    }
    <p class="mt-10 text-sm text-latte">Prices shown are placeholders.</p>
  </section>
</BaseLayout>
