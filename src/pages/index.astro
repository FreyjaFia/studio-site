---
import AppCard from '@components/app-card.astro';
import PosMock from '@components/pos-mock.astro';
import { site } from '@config/site';
import { apps } from '@data/apps';
import BaseLayout from '@layouts/base-layout.astro';

const rotatingWords: string[] = ['faster.', 'offline.', 'calmer.'];
const marqueeItems: string[] = ['Fast orders', 'Works offline', 'Sales reports', 'Promotions', 'Many shops', 'Installable app'];
const barHeights: number[] = [40, 65, 50, 85, 70, 100, 78];

interface Step {
  title: string;
  text: string;
}

const steps: Step[] = [
  { title: 'Try the demo', text: 'Open a throwaway shop with sample products and play with it. No signup.' },
  { title: 'Tell us about your shop', text: 'Send a short message. We pick a plan together and answer your questions.' },
  { title: 'Go live', text: 'We set up your shop and staff accounts so you can take your first order.' },
];
---

<BaseLayout>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-32 -right-24 size-120 animate-blob rounded-full bg-ember/25 blur-3xl"></div>
    <div class="pointer-events-none absolute top-1/2 -left-32 size-96 animate-blob rounded-full bg-sage/25 blur-3xl" style="animation-delay: -6s"></div>
    <div class="grain pointer-events-none absolute inset-0"></div>

    <div class="relative mx-auto grid max-w-6xl items-center gap-16 px-4 pt-14 pb-24 sm:px-6 lg:grid-cols-2 lg:pt-24 lg:pb-32">
      <div>
        <p class="rise inline-flex items-center gap-2 rounded-full border border-espresso/15 bg-white/60 px-4 py-1.5 text-sm font-medium">
          <span class="size-2 animate-pulse-dot rounded-full bg-sage"></span>
          {site.name} · apps for small shops
        </p>
        <h1 class="rise mt-6 font-serif text-5xl leading-[1.05] font-semibold tracking-tight sm:text-6xl lg:text-7xl" style="--d: 120ms">
          Run the counter,
          <span class="word-rotator text-ember italic">
            {rotatingWords.map((word, index) => <span style={`--i: ${index}`}>{word}</span>)}
          </span>
        </h1>
        <p class="rise mt-6 max-w-lg text-lg text-latte sm:text-xl" style="--d: 240ms">
          We build apps that carry a small business through the busy hours. Try the first one in your browser, no
          signup needed.
        </p>
        <div class="rise mt-10 flex flex-col gap-3 sm:flex-row" style="--d: 360ms">
          <a href="/apps/wtf#demo" class="group rounded-full bg-espresso px-7 py-4 text-center font-semibold text-cream transition hover:bg-ember">
            Try the live demo <span class="inline-block transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
          <a href="/apps" class="rounded-full border border-espresso/25 px-7 py-4 text-center font-semibold transition hover:bg-white">
            See our apps
          </a>
        </div>
      </div>

      <PosMock />
    </div>
  </section>

  <div class="overflow-hidden border-y border-espresso/10 bg-espresso py-4 text-cream" aria-hidden="true">
    <div class="flex w-max animate-marquee gap-10 whitespace-nowrap">
      {
        [...marqueeItems, ...marqueeItems, ...marqueeItems, ...marqueeItems].map((item) => (
          <span class="flex items-center gap-10 font-serif text-xl italic">
            {item} <span class="text-ember not-italic">✦</span>
          </span>
        ))
      }
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 data-reveal class="max-w-2xl font-serif text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">
      Built for the way a counter <span class="text-ember italic">really</span> works.
    </h2>

    <div class="mt-12 grid gap-4 md:grid-cols-6">
      <div data-reveal data-spot class="rounded-3xl bg-white p-8 md:col-span-4">
        <p class="text-sm font-semibold tracking-wide text-ember uppercase">Offline first</p>
        <h3 class="mt-3 font-serif text-3xl font-semibold">Internet down? Keep selling.</h3>
        <p class="mt-3 max-w-md text-latte">Orders are kept on the device and sync the moment the connection returns.</p>
        <div class="mt-8 h-2.5 overflow-hidden rounded-full bg-sand">
          <div class="h-full w-2/3 animate-pulse rounded-full bg-sage"></div>
        </div>
        <p class="mt-2 text-xs text-latte">Syncing 3 orders…</p>
      </div>

      <div data-reveal data-spot style="--d: 100ms" class="rounded-3xl bg-espresso p-8 text-cream md:col-span-2">
        <p class="text-sm font-semibold tracking-wide text-ember uppercase">Reports</p>
        <h3 class="mt-3 font-serif text-2xl font-semibold">Know your best day.</h3>
        <div class="mt-6 flex h-24 items-end gap-2">
          {barHeights.map((height, index) => <div class="bar flex-1 rounded-t-md bg-ember" style={`--i: ${index}; height: ${height}%`}></div>)}
        </div>
      </div>

      <div data-reveal data-spot style="--d: 0ms" class="rounded-3xl bg-sand p-8 md:col-span-2">
        <p class="text-sm font-semibold tracking-wide text-ember uppercase">Promotions</p>
        <h3 class="mt-3 font-serif text-2xl font-semibold">Deals that add up.</h3>
        <p class="mt-5 flex items-baseline gap-3 font-serif">
          <span class="text-xl text-latte line-through">₱320</span>
          <span class="text-4xl font-semibold text-ember">₱280</span>
        </p>
      </div>

      <div data-reveal data-spot style="--d: 100ms" class="rounded-3xl bg-white p-8 md:col-span-2">
        <p class="text-sm font-semibold tracking-wide text-ember uppercase">Many shops</p>
        <h3 class="mt-3 font-serif text-2xl font-semibold">One app, every branch.</h3>
        <div class="mt-5 flex -space-x-3">
          {['bg-ember', 'bg-sage', 'bg-espresso', 'bg-amber-400'].map((tone) => <span class={`size-11 rounded-full border-2 border-white ${tone}`}></span>)}
        </div>
      </div>

      <div data-reveal data-spot style="--d: 200ms" class="rounded-3xl bg-sage p-8 text-white md:col-span-2">
        <p class="text-sm font-semibold tracking-wide uppercase">Installable</p>
        <h3 class="mt-3 font-serif text-2xl font-semibold">Add it to the home screen.</h3>
        <p class="mt-3 text-white/80">Opens like an app on any phone, tablet or laptop.</p>
      </div>
    </div>
  </section>

  <section class="bg-sand">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
      <h2 data-reveal class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">From curious to open in three steps.</h2>
      <ol class="mt-14 grid gap-10 md:grid-cols-3">
        {
          steps.map((step, index) => (
            <li data-reveal style={`--d: ${index * 120}ms`}>
              <p class="font-serif text-7xl font-semibold text-ember/80">{index + 1}</p>
              <div class="mt-3 h-px w-full bg-espresso/20"></div>
              <h3 class="mt-4 font-serif text-2xl font-semibold">{step.title}</h3>
              <p class="mt-2 text-latte">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <h2 data-reveal class="font-serif text-4xl font-semibold tracking-tight sm:text-5xl">Our apps</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => <AppCard app={app} />)}
    </div>
  </section>

  <section class="relative overflow-hidden bg-espresso text-cream">
    <div class="pointer-events-none absolute -right-20 -bottom-40 size-112 animate-blob rounded-full bg-ember/40 blur-3xl"></div>
    <div class="relative mx-auto flex max-w-6xl flex-col items-start gap-8 px-4 py-24 sm:px-6 md:flex-row md:items-center md:justify-between">
      <h2 data-reveal class="max-w-xl font-serif text-4xl leading-tight font-semibold sm:text-5xl">
        Want it for <span class="text-ember italic">your</span> shop?
      </h2>
      <a href="/contact" class="rounded-full bg-cream px-8 py-4 font-semibold text-espresso transition hover:bg-ember hover:text-white">
        Contact us
      </a>
    </div>
  </section>
</BaseLayout>
