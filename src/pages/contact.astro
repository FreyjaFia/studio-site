---
import { plans } from '@data/plans';
import BaseLayout from '@layouts/base-layout.astro';

const fieldClass: string =
  'mt-2 w-full rounded-xl border border-espresso/20 bg-white px-4 py-3 text-base transition focus:border-ember focus:outline-none';
const labelClass: string = 'text-sm font-semibold';
---

<BaseLayout title="Contact" description="Tell us about your business.">
  <section class="mx-auto max-w-2xl px-4 py-16 sm:px-6 lg:py-24">
    <h1 class="rise font-serif text-5xl font-semibold tracking-tight sm:text-6xl">Say hello.</h1>
    <p class="rise mt-5 text-lg text-latte sm:text-xl" style="--d: 120ms">
      Tell us about your business and which plan interests you.
    </p>

    <form id="contact-form" class="rise mt-12 space-y-6" style="--d: 240ms">
      <div>
        <label for="name" class={labelClass}>Your name</label>
        <input id="name" name="name" type="text" required autocomplete="name" class={fieldClass} />
      </div>
      <div>
        <label for="email" class={labelClass}>Email</label>
        <input id="email" name="email" type="email" required autocomplete="email" class={fieldClass} />
      </div>
      <div>
        <label for="plan" class={labelClass}>Plan</label>
        <select id="plan" name="plan" class={fieldClass}>
          <option value="">Not sure yet</option>
          {plans.map((plan) => <option value={plan.id}>{plan.name}</option>)}
        </select>
      </div>
      <div>
        <label for="message" class={labelClass}>Message</label>
        <textarea id="message" name="message" rows="5" required class={fieldClass}></textarea>
      </div>
      <button
        type="submit"
        class="w-full rounded-full bg-espresso px-8 py-4 font-semibold text-cream transition hover:bg-ember sm:w-auto"
      >
        Send message
      </button>
      <p id="form-status" class="hidden rounded-xl bg-amber-100 p-4 text-sm text-amber-900" role="status">
        The form is not connected yet, so nothing was sent.
      </p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLElement>('#form-status');
  const planSelect = document.querySelector<HTMLSelectElement>('#plan');

  const requestedPlan: string | null = new URLSearchParams(window.location.search).get('plan');
  if (planSelect && requestedPlan) {
    planSelect.value = requestedPlan;
  }

  form?.addEventListener('submit', (event: SubmitEvent): void => {
    event.preventDefault();
    status?.classList.remove('hidden');
  });
</script>
