---
import DemoEmbed from '@components/demo-embed.astro';
import PosMock from '@components/wtf/pos-mock.astro';
import WtfBento from '@components/wtf/wtf-bento.astro';
import { apps } from '@data/apps';
import type { App } from '@data/apps';
import BaseLayout from '@layouts/base-layout.astro';

interface Props {
  app: App;
}

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;

// Apps with their own look register a hero visual and an extras block here. Others get the default visual.
const heroVisuals: Record<string, typeof PosMock> = { wtf: PosMock };
const extraBlocks: Record<string, typeof WtfBento> = { wtf: WtfBento };
const HeroVisual = heroVisuals[app.slug];
const Extras = extraBlocks[app.slug];
---

<BaseLayout title={app.name} description={`${app.tagline} ${app.pitch}`}>
  <div style={`--accent: ${app.accent}`}>
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-24 -right-24 size-104 animate-blob rounded-full bg-(--accent)/20 blur-3xl"></div>
      <div class="relative mx-auto grid max-w-6xl items-center gap-16 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24">
        <div>
          <p class="rise text-sm font-semibold tracking-wide text-(--accent) uppercase">
            {app.category}{app.status === 'soon' ? ' · Coming soon' : ''}
          </p>
          <h1 class="rise mt-3 font-serif text-5xl font-semibold tracking-tight sm:text-6xl" style="--d: 100ms">{app.name}</h1>
          <p class="rise mt-5 max-w-lg text-lg text-latte sm:text-xl" style="--d: 200ms">{app.tagline} {app.pitch}</p>
          <div class="rise mt-8 flex flex-col gap-3 sm:flex-row" style="--d: 300ms">
            <a href="#demo" class="rounded-full bg-espresso px-7 py-4 text-center font-semibold text-cream transition hover:bg-(--accent)">
              Try the demo
            </a>
            <a href={`/pricing#${app.slug}`} class="rounded-full border border-espresso/25 px-7 py-4 text-center font-semibold transition hover:bg-white">
              See pricing
            </a>
          </div>
        </div>
        {
          HeroVisual ? (
            <HeroVisual />
          ) : (
            <div class="rise mx-auto flex aspect-square w-full max-w-sm items-center justify-center rounded-[3rem] bg-(--accent) font-serif text-9xl font-semibold text-white" style="--d: 300ms">
              {app.name.charAt(0)}
            </div>
          )
        }
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
      <h2 data-reveal class="font-serif text-3xl font-semibold sm:text-4xl">What you get</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          app.features.map((feature, index) => (
            <li data-reveal data-spot style={`--d: ${index * 80}ms`} class="flex gap-4 rounded-2xl border border-espresso/10 bg-white p-5">
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-(--accent)/10 text-(--accent)" aria-hidden="true">✓</span>
              <span class="pt-1">{feature}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      Extras && (
        <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
          <Extras />
        </section>
      )
    }

    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
      <h2 data-reveal class="font-serif text-3xl font-semibold sm:text-4xl">Screenshots</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          app.screenshots.map((label, index) => (
            <div
              data-reveal
              style={`--d: ${index * 100}ms`}
              class="flex aspect-video items-center justify-center rounded-2xl border border-dashed border-espresso/25 bg-sand/60 text-sm text-latte"
            >
              {label}, screenshot coming
            </div>
          ))
        }
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
      <h2 data-reveal class="mb-8 font-serif text-3xl font-semibold sm:text-4xl">Live demo</h2>
      <DemoEmbed appName={app.name} demoUrl={app.demoUrl} />
    </section>
  </div>
</BaseLayout>
