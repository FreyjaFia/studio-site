---
import DemoEmbed from '@components/demo-embed.astro';
import PosMock from '@components/pos-mock.astro';
import { apps } from '@data/apps';
import BaseLayout from '@layouts/base-layout.astro';

const app = apps.find((candidate) => candidate.slug === 'wtf');
if (!app) {
  throw new Error('WTF app data is missing');
}

const screenshotLabels: string[] = ['Order screen', 'Sales report', 'Product list'];
---

<BaseLayout title={app.name} description={app.pitch}>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute -top-24 -right-24 size-104 animate-blob rounded-full bg-ember/20 blur-3xl"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-16 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="rise text-sm font-semibold tracking-wide text-ember uppercase">App #1</p>
        <h1 class="rise mt-3 font-serif text-5xl font-semibold tracking-tight sm:text-6xl" style="--d: 100ms">{app.name}</h1>
        <p class="rise mt-5 max-w-lg text-lg text-latte sm:text-xl" style="--d: 200ms">{app.pitch}</p>
        <div class="rise mt-8 flex flex-col gap-3 sm:flex-row" style="--d: 300ms">
          <a href="#demo" class="rounded-full bg-espresso px-7 py-4 text-center font-semibold text-cream transition hover:bg-ember">
            Try the demo
          </a>
          <a href="/pricing" class="rounded-full border border-espresso/25 px-7 py-4 text-center font-semibold transition hover:bg-white">
            See pricing
          </a>
        </div>
      </div>
      <PosMock />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 data-reveal class="font-serif text-3xl font-semibold sm:text-4xl">What you get</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        app.features.map((feature, index) => (
          <li data-reveal data-spot style={`--d: ${index * 80}ms`} class="flex gap-4 rounded-2xl border border-espresso/10 bg-white p-5">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-ember/10 text-ember" aria-hidden="true">✓</span>
            <span class="pt-1">{feature}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 data-reveal class="font-serif text-3xl font-semibold sm:text-4xl">Screenshots</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        screenshotLabels.map((label, index) => (
          <div
            data-reveal
            style={`--d: ${index * 100}ms`}
            class="flex aspect-video items-center justify-center rounded-2xl border border-dashed border-espresso/25 bg-sand/60 text-sm text-latte"
          >
            {label}, screenshot coming
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
    <h2 data-reveal class="mb-8 font-serif text-3xl font-semibold sm:text-4xl">Live demo</h2>
    <DemoEmbed />
  </section>
</BaseLayout>
