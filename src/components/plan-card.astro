---
import type { Plan } from '@data/plans';

interface Props {
  plan: Plan;
  delay?: number;
}

const { plan, delay = 0 } = Astro.props;
---

<div
  data-reveal
  data-spot
  style={`--d: ${delay}ms`}
  class:list={[
    'flex h-full flex-col rounded-3xl border p-7 transition hover:-translate-y-1 hover:shadow-xl sm:p-8',
    plan.highlighted ? 'border-espresso bg-espresso text-cream' : 'border-espresso/10 bg-white',
  ]}
>
  {
    plan.highlighted && (
      <span class="mb-4 w-fit rounded-full bg-ember px-3 py-1 text-xs font-semibold tracking-wide text-white uppercase">
        Most popular
      </span>
    )
  }
  <h3 class="font-serif text-2xl font-semibold">{plan.name}</h3>
  <p class="mt-4 font-serif text-4xl font-semibold tracking-tight lg:text-5xl">{plan.price}</p>
  <p class:list={['mt-1 text-sm', plan.highlighted ? 'text-cream/60' : 'text-latte']}>{plan.note}</p>
  <ul class="mt-6 flex-1 space-y-3">
    {
      plan.features.map((feature) => (
        <li class="flex gap-3">
          <span class="text-ember" aria-hidden="true">✓</span>
          <span>{feature}</span>
        </li>
      ))
    }
  </ul>
  <a
    href={`/contact?plan=${plan.id}`}
    class:list={[
      'mt-8 rounded-full px-6 py-3.5 text-center font-semibold transition',
      plan.highlighted ? 'bg-ember text-white hover:bg-white hover:text-espresso' : 'bg-espresso text-cream hover:bg-ember',
    ]}
  >
    Contact us
  </a>
</div>
