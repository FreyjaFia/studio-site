---
import { navLinks, site } from '@config/site';
import { apps } from '@data/apps';

const year: number = new Date().getFullYear();
---

<footer class="bg-espresso text-cream">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="max-w-xl font-serif text-3xl leading-tight sm:text-4xl">
      Good tools make the <span class="text-ember italic">busy hours</span> feel calm.
    </p>
    <div class="mt-12 grid gap-10 border-t border-cream/15 pt-8 sm:grid-cols-2 md:grid-cols-4">
      <p class="font-serif text-lg font-semibold">{site.name}</p>
      <nav aria-label="Apps">
        <p class="text-xs font-semibold tracking-wide text-cream/50 uppercase">Apps</p>
        <ul class="mt-3 space-y-2">
          {
            apps.map((app) => (
              <li>
                <a href={`/apps/${app.slug}`} class="text-sm text-cream/70 transition hover:text-white">{app.name}</a>
              </li>
            ))
          }
          <li><a href="/apps" class="text-sm text-cream/70 transition hover:text-white">All apps</a></li>
        </ul>
      </nav>
      <nav aria-label="Footer">
        <p class="text-xs font-semibold tracking-wide text-cream/50 uppercase">Studio</p>
        <ul class="mt-3 space-y-2">
          {
            navLinks.map((link) => (
              <li><a href={link.href} class="text-sm text-cream/70 transition hover:text-white">{link.label}</a></li>
            ))
          }
        </ul>
      </nav>
      <p class="text-sm text-cream/60 md:text-right">© {year} {site.name}</p>
    </div>
  </div>
</footer>
