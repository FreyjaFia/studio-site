---
import { navLinks, site } from '@config/site';

const year: number = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="font-bold text-slate-900">{site.name}</p>
      <p class="mt-1 text-sm text-slate-600">{site.tagline}</p>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
      {
        navLinks.map((link) => (
          <a href={link.href} class="text-sm text-slate-600 hover:text-indigo-600">
            {link.label}
          </a>
        ))
      }
    </nav>
    <p class="text-sm text-slate-500">© {year} {site.name}</p>
  </div>
</footer>
