---
import { navLinks, site } from '@config/site';

const year: number = new Date().getFullYear();
---

<footer class="bg-espresso text-cream">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <p class="max-w-xl font-serif text-3xl leading-tight sm:text-4xl">
      Good tools make the <span class="text-ember italic">busy hours</span> feel calm.
    </p>
    <div class="mt-12 flex flex-col gap-6 border-t border-cream/15 pt-8 md:flex-row md:items-center md:justify-between">
      <p class="font-serif text-lg font-semibold">{site.name}</p>
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Footer">
        {
          navLinks.map((link) => (
            <a href={link.href} class="text-sm text-cream/70 transition hover:text-white">
              {link.label}
            </a>
          ))
        }
      </nav>
      <p class="text-sm text-cream/60">© {year} {site.name}</p>
    </div>
  </div>
</footer>
