---
import type { App } from '@data/apps';

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<a
  href={`/apps/${app.slug}`}
  data-spot
  data-reveal
  class="group flex h-full flex-col rounded-3xl border border-espresso/10 bg-white p-7 transition hover:-translate-y-1 hover:shadow-xl"
>
  <div
    class="flex size-14 items-center justify-center rounded-2xl bg-ember font-serif text-2xl font-semibold text-white transition group-hover:rotate-6"
  >
    {app.name.charAt(0)}
  </div>
  <h3 class="mt-5 font-serif text-2xl font-semibold">{app.name}</h3>
  <p class="mt-2 flex-1 text-latte">{app.pitch}</p>
  <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-ember">
    See the app <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span>
  </span>
</a>
