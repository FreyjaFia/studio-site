---
import type { App } from '@data/apps';

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<a
  href={`/apps/${app.slug}`}
  class="group flex h-full flex-col rounded-2xl border border-slate-200 p-6 transition hover:border-indigo-300 hover:shadow-md"
>
  <div class="flex size-12 items-center justify-center rounded-xl bg-indigo-50 text-lg font-bold text-indigo-600">
    {app.name.charAt(0)}
  </div>
  <h3 class="mt-4 text-xl font-semibold text-slate-900">{app.name}</h3>
  <p class="mt-2 flex-1 text-slate-600">{app.pitch}</p>
  <span class="mt-4 text-sm font-semibold text-indigo-600 group-hover:underline">See the app →</span>
</a>
