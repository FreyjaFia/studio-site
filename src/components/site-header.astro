---
import { navLinks, site } from '@config/site';

const currentPath: string = Astro.url.pathname;
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-6">
  <div
    class="rise mx-auto flex h-14 max-w-6xl items-center justify-between rounded-full border border-espresso/10 bg-cream/80 pr-2 pl-5 shadow-sm backdrop-blur-md"
  >
    <a href="/" class="flex items-center gap-2 font-serif text-xl font-semibold tracking-tight">
      <span class="size-2.5 rounded-full bg-ember"></span>
      {site.name}
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-medium transition hover:bg-espresso/5',
              currentPath.startsWith(link.href) ? 'text-ember' : 'text-latte',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/apps/wtf#demo"
        class="ml-2 rounded-full bg-espresso px-5 py-2.5 text-sm font-semibold text-cream transition hover:bg-ember"
      >
        Try the demo
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-full bg-espresso text-cream [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M5 8h14M5 16h14"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-3 flex w-60 flex-col rounded-2xl border border-espresso/10 bg-cream p-2 shadow-xl"
        aria-label="Mobile"
      >
        {
          navLinks.map((link) => (
            <a href={link.href} class="rounded-xl px-4 py-3 font-medium hover:bg-sand">
              {link.label}
            </a>
          ))
        }
        <a href="/apps/wtf#demo" class="mt-1 rounded-xl bg-ember px-4 py-3 text-center font-semibold text-white">
          Try the demo
        </a>
      </nav>
    </details>
  </div>
</header>
