---
import { navLinks, site } from '@config/site';

const currentPath: string = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="text-lg font-bold tracking-tight text-slate-900">{site.name}</a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium hover:text-indigo-600',
              currentPath.startsWith(link.href) ? 'text-indigo-600' : 'text-slate-600',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/apps/wtf#demo"
        class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500"
      >
        Try the demo
      </a>
    </nav>

    <details class="group relative md:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </summary>
      <nav
        class="absolute right-0 mt-2 flex w-56 flex-col rounded-xl border border-slate-200 bg-white p-2 shadow-lg"
        aria-label="Mobile"
      >
        {
          navLinks.map((link) => (
            <a href={link.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
              {link.label}
            </a>
          ))
        }
        <a
          href="/apps/wtf#demo"
          class="mt-1 rounded-lg bg-indigo-600 px-3 py-2.5 text-center text-sm font-semibold text-white"
        >
          Try the demo
        </a>
      </nav>
    </details>
  </div>
</header>
