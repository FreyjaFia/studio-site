---
import { apps } from '@data/apps';

const shown = apps.slice(0, 3);
---

<div class="relative mx-auto w-full max-w-md space-y-4">
  {
    shown.map((app, index) => (
      <div
        class:list={['rise', index % 2 === 1 ? 'sm:translate-x-8' : 'sm:-translate-x-4']}
        style={`--d: ${300 + index * 150}ms`}
      >
        <a
          href={`/apps/${app.slug}`}
          class="flex animate-float items-center gap-4 rounded-3xl border border-espresso/10 bg-white p-5 shadow-xl transition hover:-translate-y-1"
          style={`animation-delay: ${index * -2}s`}
        >
          <span
            class="flex size-14 shrink-0 items-center justify-center rounded-2xl font-serif text-2xl font-semibold text-white"
            style={`background: ${app.accent}`}
          >
            {app.name.charAt(0)}
          </span>
          <span class="min-w-0">
            <span class="block font-serif text-xl font-semibold">{app.name}</span>
            <span class="block truncate text-sm text-latte">{app.tagline}</span>
          </span>
        </a>
      </div>
    ))
  }
  <div class="rise sm:translate-x-4" style={`--d: ${300 + shown.length * 150}ms`}>
    <div class="flex items-center gap-4 rounded-3xl border-2 border-dashed border-espresso/25 p-5">
      <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-sand font-serif text-2xl text-latte">+</span>
      <span>
        <span class="block font-serif text-xl font-semibold">Your next app</span>
        <span class="block text-sm text-latte">More are on the way.</span>
      </span>
    </div>
  </div>
</div>
