---
interface Props {
  appName: string;
  demoUrl?: string;
}

const { appName, demoUrl } = Astro.props;
---

<section id="demo" class="scroll-mt-24">
  <div data-reveal class="overflow-hidden rounded-3xl border border-espresso/10 bg-sand">
    {
      demoUrl ? (
        <iframe src={demoUrl} title={`${appName} live demo`} class="h-[70vh] min-h-96 w-full" loading="lazy"></iframe>
      ) : (
        <div class="flex min-h-80 flex-col items-center justify-center gap-4 p-8 text-center">
          <div class="flex size-16 animate-float items-center justify-center rounded-full bg-(--accent) text-2xl text-white" aria-hidden="true">▶</div>
          <h3 class="font-serif text-3xl font-semibold">Live demo coming soon</h3>
          <p class="max-w-md text-latte">
            You will get your own throwaway copy of {appName} with sample data. It resets after about two hours.
          </p>
          <a href="/contact" class="rounded-full bg-espresso px-6 py-3 font-semibold text-cream transition hover:bg-(--accent)">
            Ask for early access
          </a>
        </div>
      )
    }
  </div>
</section>
